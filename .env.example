# Copy to ~/.claude/.env (or $CLAUDE_CONFIG_DIR/.env) and fill in. Read by apply.sh for MCP
# registration and by the retention Stop hook at runtime. The real file holds secrets — keep it
# out of version control; only this .example is committed.

# ── Hindsight (long-term memory) ─────────────────────────────────────────────
HINDSIGHT_API_URL=https://hindsight.example.com   # base URL, without the /mcp suffix
HINDSIGHT_API_KEY=                                # SECRET bearer token
HINDSIGHT_BANK_ID=main                            # the bank all sessions retain into and recall from

# ── Obsidian (research & design vault, served headless by mcpvault over stdio) ─
# No secret: mcpvault is a local stdio process reading the vault directory directly.
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian/Vault    # vault root on disk; a leading ~/ is expanded
OBSIDIAN_MCPVAULT_BIN=/opt/mcpvault/bin/mcpvault  # bitbonsai/mcpvault entrypoint

# Optional: tag retained memories with user:<value>, matching the bank's convention.
HINDSIGHT_USER_TAG=
