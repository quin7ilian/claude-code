#!/usr/bin/env bash
# codex-review — run a Codex code review of a repository change set against a brief.
#
# The review gate for coding deliverables: the caller writes a self-contained brief
# (task, spec, acceptance criteria, exact diff range), this script appends the reviewer
# contract and runs the Codex CLI from an ephemeral scratch workspace with network and
# web access. The workspace-write sandbox covers only the scratch and /tmp, so the
# repository under review stays kernel-enforced read-only. Codex inherits the user's
# configured model and reasoning effort; no model or effort flags are passed here. Runs
# on the ChatGPT subscription — no pay-per-token key.
#
# The review ends with a `verdict: PASS` or `verdict: NEEDS_CHANGES` line. A missing,
# failed, or empty review exits non-zero — an unavailable reviewer is NEVER a pass.
#
# A re-review round resumes the first round's session (--resume with --session-file), so the
# reviewer keeps the repository it already explored and its own findings in context instead of
# re-deriving both. `codex exec resume` accepts neither --sandbox nor -C: the sandbox is
# re-asserted with -c, or the run silently inherits the user's configured default, and the
# working root is the process cwd. Every re-review also names the earlier rounds' review files
# (--prior), which the reviewer reads verbatim — a session that compacts, and a resume that
# fails into a fresh session, must still meet its own earlier findings rather than a paraphrase.
#
# Usage:
#   codex-review --brief /abs/brief.md --repo /abs/repo [--out /abs/review.md]
#                [--prior /abs/round-N.md]... [--session-file /abs/session.id] [--resume]
set -euo pipefail

BRIEF="" REPO="" OUT="" SESSION_FILE="" RESUME=0
PRIORS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --brief)        BRIEF="${2:-}";        shift 2 ;;
    --repo)         REPO="${2:-}";         shift 2 ;;
    --out)          OUT="${2:-}";          shift 2 ;;
    --prior)        PRIORS+=("${2:-}");    shift 2 ;;
    --session-file) SESSION_FILE="${2:-}"; shift 2 ;;
    --resume)       RESUME=1;              shift ;;
    *) echo "codex-review: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

if [ -z "$BRIEF" ] || [ -z "$REPO" ]; then
  echo "usage: codex-review --brief FILE --repo DIR [--out FILE] [--prior FILE]... [--session-file FILE] [--resume]" >&2
  exit 2
fi
if [ ! -f "$BRIEF" ]; then
  echo "codex-review: brief file not found: $BRIEF" >&2
  exit 2
fi
for prior in ${PRIORS[@]+"${PRIORS[@]}"}; do
  if [ ! -f "$prior" ]; then
    echo "codex-review: prior review not found: $prior" >&2
    exit 2
  fi
done
# A resumed round is a re-review, and a re-review that cannot point at what the reviewer said
# last time is the round that argues a finding away in the owner's words.
if [ "$RESUME" -eq 1 ]; then
  if [ -z "$SESSION_FILE" ]; then
    echo "codex-review: --resume requires --session-file" >&2
    exit 2
  fi
  if [ "${#PRIORS[@]}" -eq 0 ]; then
    echo "codex-review: --resume requires at least one --prior (the previous round's review file)" >&2
    exit 2
  fi
fi
if [ ! -d "$REPO" ]; then
  echo "codex-review: repository directory not found: $REPO" >&2
  exit 2
fi
if ! command -v codex >/dev/null 2>&1; then
  echo "codex-review: codex CLI not found on PATH — review NOT run; this is NOT a pass" >&2
  exit 1
fi

# A background watcher owns the graph's freshness; this only confirms one is running and
# the graph is caught up before the brief tells the reviewer the graph exists. Codex runs
# read-only, so a stale graph would go uncorrected for the whole review — the note is set
# only when that confirmation succeeded, never to describe a stale graph as current.
GRAPH_NOTE=""
GRAPH_WATCH="$(dirname "$(dirname "$(readlink -f "$0")")")/scripts/start_graph_watch.py"
if [ -f "$REPO/.code-review-graph/graph.db" ] && [ -f "$GRAPH_WATCH" ]; then
  # A sync that finds no graph at all also exits 0, so the graph is re-checked after it: a
  # graph removed mid-run leaves the note out rather than being described as current.
  if python3 "$GRAPH_WATCH" --repo "$REPO" --sync \
      && [ -f "$REPO/.code-review-graph/graph.db" ]; then
    # __REPO__ is substituted below: the CLI resolves its repository from the working
    # directory, which here is the scratch, so every example names the repository instead.
    GRAPH_NOTE='

## Code graph

This repository carries a code graph, kept continuously current by a background watcher.
Answer structural questions read-only with `code-review-graph` directly, naming the
repository in every command — without `--repo` the CLI reads your scratch working directory
and answers from an empty graph:
`code-review-graph query --repo __REPO__ callers_of|callees_of|tests_for|importers_of|file_summary <symbol>`,
`code-review-graph search --repo __REPO__ "<terms>"` (semantic when the repository has an
embedding index), `code-review-graph detect-changes --repo __REPO__ --brief` (changed
functions and test gaps). Prefer it over repository-wide greps for locating callers,
dependents, and covering tests: orient with `code-review-graph architecture --repo __REPO__`
or `code-review-graph communities --repo __REPO__` before opening unfamiliar files, pair
`code-review-graph detect-changes --repo __REPO__ --brief` with
`code-review-graph query --repo __REPO__ tests_for <symbol>` on changed functions to expose
untested changes, and use `code-review-graph impact --repo __REPO__` for the blast radius of
the current changes. Never run `update`, `build`, or `embed`: a background watcher is the
only writer, and they would fail in this sandbox anyway. An edge is admissible evidence for
a structural finding — this call, import, inheritance, or test exists at this file:line —
and the repository is frozen read-only for this review, so what the graph reports is what
the tree holds. Read the file for what a call passes, what a branch tests, or what a default
is: the graph stores declared signatures and call sites, never argument values. Never assert
an absence — no remaining caller, dead code, a completed removal — from the graph alone,
since it reports dynamic dispatch, string-keyed registration, and config-declared entry
points as zero callers. Never treat its risk scores or savings estimates as findings.'
    GRAPH_NOTE="${GRAPH_NOTE//__REPO__/$REPO}"
  else
    echo "codex-review: code graph freshness unverified — graph guidance omitted from the brief" >&2
  fi
fi

CONTRACT='Act as a skeptical, evidence-driven code reviewer. Start with the specified git diff and
changed files. Before judging anything, read the repository'"'"'s instruction files — AGENTS.md and
CLAUDE.md at the repository root and in every directory the change touches, plus any files they
import. They are binding: a change that violates them is a finding regardless of whether it is
otherwise correct, and they outrank your own general practice. Expand only into directly touched
callers, callees, interfaces, library contracts, and tests when needed to prove or disprove a
concrete concern. Do not map or summarize the whole repository.

Challenge the implementation'"'"'s assumptions. Check the change against the task, specification,
acceptance criteria, and repository instructions. Pressure-test correctness, edge cases, failure
handling, security boundaries, compatibility, concurrency/state behavior where relevant, and
whether the tests genuinely prove the behavior rather than merely mirror the implementation.
The repository is kernel-enforced read-only; your working directory is an ephemeral scratch space
and /tmp is writable — write probe scripts and artifacts there, and run the smallest relevant
tests or static checks that need no repository writes. You have network and web access for
documentation and fact-checking. If a check genuinely requires writing the repository itself,
report the exact check that could not run and why. Never attempt to modify the repository and
never read secrets.

Return no more than 8 high-confidence, actionable findings. Omit speculative issues and style
nits — but a rule written in a repository instruction file is a contract, never a nit: violating
it is a reportable finding even when the rule governs comments, docstrings, naming, or other
prose. When one rule is violated at many sites, report the rule once as a single finding carrying
representative file:line examples and the stated full extent — the cap limits findings, not the
sites a finding covers.
For each finding name the contract it violates — the specification or acceptance criteria in the
brief, a repository instruction, or a documented language/framework/library contract — plus
severity, file:line, evidence, a concrete failure scenario stating the conditions under which the
defect fires, the conditions under which it does not, and the observable effect, and a specific fix
or verification step. For a violated instruction-file rule whose cost is not a runtime failure,
the failure scenario is the cost the rule itself names — what the violation does to the reader,
maintainer, or process the rule protects. A finding too terse to show its reader when the problem
happens is not actionable. A detail the specification
omits is a decision not made, not a defect, and current usage is never a contract: do not demand a
restriction merely because every present caller would satisfy it. A finding whose violated contract
you cannot name is one you do not report. Never prescribe a fix that creates dead surface — a flag
that only rejects, a parameter with no legal value, a branch nothing can reach. Separate confirmed
defects from questions. End with:
(1) verdict: PASS or NEEDS_CHANGES, (2) tests/checks run and results, (3) assumptions challenged,
(4) the narrow scope inspected, (5) repository-instruction compliance: name every AGENTS.md/CLAUDE.md
file you read by path and state, rule by rule for the ones this change engages, whether it complies —
report each violated rule as a finding. If you found no instruction files, say so explicitly. Omitting
this section makes the review incomplete. If there are no findings, say so plainly; do not invent
issues.'

PRIOR_NOTE=""
if [ "${#PRIORS[@]}" -gt 0 ]; then
  PRIOR_LIST=""
  for prior in "${PRIORS[@]}"; do
    PRIOR_LIST="${PRIOR_LIST}${prior}
"
  done
  PRIOR_NOTE="

## Your earlier reviews of this change

${PRIOR_LIST}
Read these before judging anything: they are your own findings from the earlier rounds, verbatim.
The brief files each one under an adjudication and references it rather than restating it, because
a finding that reaches you only in the owner's words is a different finding — one you never wrote,
and one you can accept a rewording of after refusing the original."
fi

RESUME_NOTE=""
if [ "$RESUME" -eq 1 ]; then
  RESUME_NOTE="

## This round continues your own session

The working tree has moved since your last round: the fixes the brief adjudicates have landed.
Your memory of what these files contain is stale — re-read every file the fix delta touches
before judging it. Never clear a change against your recollection of how the file used to read."
fi

PROMPT="## Repository under review

${REPO} — kernel-enforced read-only. Your working directory is an ephemeral scratch
space, not the repository: inspect the repository by absolute path and run git as
\`git -C ${REPO} ...\`.

$(cat "$BRIEF")$PRIOR_NOTE$GRAPH_NOTE$RESUME_NOTE

## Reviewer contract

$CONTRACT"

ERR="$(mktemp "${TMPDIR:-/tmp}/codex-review.XXXXXX.stderr")"
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/codex-review-scratch.XXXXXX")"
trap 'rm -f "$ERR"; rm -rf "$SCRATCH"' EXIT

SID=""
if [ "$RESUME" -eq 1 ] && [ -f "$SESSION_FILE" ]; then
  SID="$(tr -d '[:space:]' <"$SESSION_FILE")"
fi

# </dev/null: never block on interactive auth/TTY. Codex writes its banner, progress and
# diagnostics to stderr and the review itself to stdout, so the review is captured whole.
# The workspace-write sandbox covers the scratch cwd and /tmp only; kernel-enforcement
# prevents any write to the repository, in a resumed session as much as a fresh one.
run_codex() {
  if [ "$1" = "resume" ]; then
    # No -C and no --sandbox on resume: the working root is the process cwd, and without the
    # -c override the run inherits the user's configured sandbox_mode instead of this one.
    ( cd "$SCRATCH" && codex exec resume "$SID" --skip-git-repo-check \
        -c sandbox_mode='"workspace-write"' \
        -c sandbox_workspace_write.network_access=true \
        -c web_search=live \
        "$PROMPT" </dev/null 2>"$ERR" )
  else
    codex exec --skip-git-repo-check \
      --sandbox workspace-write \
      -c sandbox_workspace_write.network_access=true \
      -c web_search=live \
      -C "$SCRATCH" \
      "$PROMPT" </dev/null 2>"$ERR"
  fi
}

set +e
if [ -n "$SID" ]; then
  OUTPUT="$(run_codex resume)"
  STATUS=$?
  # A session Codex can no longer resume is a slower round, never a skipped one: the prompt
  # already carries the brief and the prior rounds' reviews, so a fresh session reviews the
  # same material without the context the resume would have saved.
  if [ "$STATUS" -ne 0 ] || [ -z "$OUTPUT" ]; then
    echo "codex-review: could not resume session $SID — running a fresh session instead" >&2
    sed -n '1,10p' "$ERR" >&2 || true
    OUTPUT="$(run_codex fresh)"
    STATUS=$?
  fi
else
  OUTPUT="$(run_codex fresh)"
  STATUS=$?
fi
set -e
SIZE=${#OUTPUT}

if [ "$STATUS" -ne 0 ] || [ "$SIZE" -eq 0 ]; then
  echo "codex-review: review FAILED (exit $STATUS, ${SIZE} bytes) — this is NOT a pass" >&2
  sed -n '1,10p' "$ERR" >&2 || true
  exit 1
fi

if [ -n "$OUT" ]; then
  printf '%s\n' "$OUTPUT" >"$OUT"
else
  printf '%s\n' "$OUTPUT"
fi

# The id is recorded only after a review that succeeded, and a resumed run reports the same id
# it was given, so the file keeps naming the session the next round should continue — including
# the new one a fallback just created.
if [ -n "$SESSION_FILE" ]; then
  NEW_SID="$(grep -m1 -oE 'session id: [0-9a-fA-F-]{36}' "$ERR" | awk '{print $3}')"
  if [ -n "$NEW_SID" ]; then
    printf '%s\n' "$NEW_SID" >"$SESSION_FILE"
  else
    echo "codex-review: no session id in Codex output — the next round starts a fresh session" >&2
  fi
fi
